# MK AI Command Center — environment template
# Copy to .env and fill real values. NEVER commit real values.

# --- Core ---
NODE_ENV=development
# Directory for SQLite database and artifacts
MKCC_DATA_DIR=./data
# Optional explicit DB path (defaults to MKCC_DATA_DIR/mkcc.db)
# MKCC_DB_PATH=./data/mkcc.db
PUBLIC_APP_URL=http://localhost:3100

# --- Branding (config-driven) ---
APP_NAME=MK AI Command Center
APP_OWNER_NAME=Musharraf Kazi
APP_OWNER_EMAIL=

# --- Auth ---
# 32+ chars. Generate: openssl rand -hex 32
AUTH_SECRET=
# Owner login credentials (used by seed)
OWNER_EMAIL=owner@mkcc.local
OWNER_PASSWORD=
SESSION_TTL_DAYS=30

# --- AI providers (set the ones you have; unset providers stay disabled) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# --- Local free brain (Ollama — Chinese open-weight models on this machine) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# --- Chinese open-weight providers (OpenAI-compatible, keys optional) ---
DEEPSEEK_API_KEY=
QWEN_API_KEY=
GLM_API_KEY=

# mock | openai | gemini | groq | anthropic | ollama | deepseek | qwen | glm  (mock = deterministic offline provider)
AI_DEFAULT_PROVIDER=mock
AI_DAILY_BUDGET_USD=20
AI_MONTHLY_BUDGET_USD=300

# --- Telegram control plane ---
# Create a bot with @BotFather. Leave empty to disable Telegram.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids allowed to control the system (find via /start + logs)
TELEGRAM_ALLOWED_CHAT_IDS=
# Base URL used in dashboard links sent over Telegram
TELEGRAM_DASHBOARD_BASE_URL=http://localhost:3100

# --- Email notifications (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL_TO=

# --- Worker tuning ---
WORKER_POLL_MS=2000
SCHEDULER_POLL_MS=15000
JOB_LEASE_MS=300000
# true/false overrides (default: worker on, telegram on only if token set)
ENABLE_WORKER=true
# ENABLE_TELEGRAM=false
